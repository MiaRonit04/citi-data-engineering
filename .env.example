# ============================================================================
#  ACME Analytics Platform — environment configuration
#  Copy to `.env` and adjust. NEVER commit the real `.env`.
#  All settings are consumed via etl.common.config.Settings (pydantic-settings).
# ============================================================================

# ── Environment ─────────────────────────────────────────────────────────────
APP_ENV=development                 # development | testing | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Paths (relative to project root or absolute) ────────────────────────────
DATASETS_DIR=datasets/data-engineering-sample-teams-scenario
LAKEHOUSE_DIR=lakehouse
BRONZE_DIR=lakehouse/bronze
SILVER_DIR=lakehouse/silver
GOLD_DIR=lakehouse/gold
QUARANTINE_DIR=lakehouse/quarantine
REPORTS_DIR=reports
LOGS_DIR=logs

# ── Pipeline behaviour ──────────────────────────────────────────────────────
PARQUET_COMPRESSION=snappy          # snappy | zstd | gzip
RETRY_COUNT=3
RETRY_BACKOFF_SECONDS=2.0
CHUNK_SIZE=100000

# ── Data-quality thresholds (0..1). Pipeline warns below these. ──────────────
QUALITY_MIN_SCHEMA_VALID=0.95
QUALITY_MIN_RELATIONSHIP_VALID=0.90
QUALITY_MAX_DUPLICATE_RATIO=0.05
QUALITY_MAX_MISSING_RATIO=0.30

# ── Business rules (configurable, never hardcoded in logic) ─────────────────
NON_DIRECT_RATIO_THRESHOLD=0.20     # Q6: "greater than 20%"
ALLOCATION_MIN=0                    # valid allocation_pct lower bound
ALLOCATION_MAX=100                  # valid allocation_pct upper bound

# ── PostgreSQL (optional serving DB / metadata store) ───────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=acme_analytics
POSTGRES_USER=acme
POSTGRES_PASSWORD=change_me
# Full URL is derived from the parts above if left blank.
DATABASE_URL=
